# Generate unique local values: npm run setup:env
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://forma:CHANGE_ME@127.0.0.1:55432/forma?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
SEED_USER_PASSWORD=REPLACE_WITH_ANOTHER_UNIQUE_PASSWORD
UPLOAD_DIR=uploads
TRUST_PROXY=0
# Optional: serve the Vite production build through Express (path relative to process cwd).
# Leave unset for the existing Vite development / Docker Nginx setup.
# FRONTEND_DIR=../frontend/dist
# Vite reads this at build time. Public portfolio demos must keep it true.
VITE_DEMO_MODE=false
# Docker Compose (use a unique password; DATABASE_URL is composed inside Docker)
POSTGRES_USER=forma
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD
POSTGRES_DB=forma
WEB_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
