{
  "name": "forma-store",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w backend",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "setup:env": "node scripts/setup-env.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1",
    "embedded-postgres": "18.4.0-beta.17"
  },
  "overrides": {
    "qs": "^6.16.0",
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
